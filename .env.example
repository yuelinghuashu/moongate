# 域名
NUXT_PUBLIC_SITE_URL=

# 数据库连接地址
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=   # 不要用123456，建议用随机字符串

# 应用连接字符串（使用服务名 postgres）
NUXT_DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}

# nuxt-auth-utils模块的session密钥
NUXT_SESSION_PASSWORD=

# OAuth的Github客户端id和密钥
NUXT_OAUTH_GITHUB_CLIENT_ID=
NUXT_OAUTH_GITHUB_CLIENT_SECRET=
